{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gsp-compliance/schemas/interaction_record",
  "title": "Interaction Record",
  "description": "Complete trace of one user interaction from entry to agent response. Ties together prefilter, LLM intent, permission check, and agent result.",
  "type": "object",
  "required": [
    "interaction_id",
    "user_id",
    "window_id",
    "user_message",
    "timestamp"
  ],
  "properties": {
    "interaction_id": {
      "type": "string",
      "description": "Unique interaction identifier (UUID or timestamp-based)."
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "received",
        "prefiltered",
        "intent_classified",
        "permission_checked",
        "routed",
        "responded",
        "blocked",
        "errored"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "user_id": {
      "type": "string",
      "description": "FK to user_registry.user_id."
    },
    "window_id": {
      "type": "string",
      "description": "FK to agent_window_permission.window_id."
    },
    "user_message": {
      "type": "string",
      "description": "Original user message text."
    },
    "message_type": {
      "type": "string",
      "enum": [
        "text",
        "image",
        "file",
        "voice"
      ]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "When the message was received."
    },
    "prefilter_result": {
      "type": "object",
      "description": "FK/ref to intent_prefilter result. Required before LLM intent.",
      "required": [
        "prefilter_id"
      ],
      "properties": {
        "prefilter_id": {
          "type": "string"
        },
        "matched": {
          "type": "boolean"
        },
        "suggested_window": {
          "type": "string"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "llm_intent_result": {
      "type": "object",
      "description": "FK/ref to llm_intent_result. Required for routing decision.",
      "required": [
        "intent_id"
      ],
      "properties": {
        "intent_id": {
          "type": "string"
        },
        "selected_agent": {
          "type": "string"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "permission_result": {
      "type": "object",
      "description": "FK/ref to permission_check_result.",
      "properties": {
        "check_id": {
          "type": "string"
        },
        "allowed": {
          "type": "boolean"
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "routed_to_agent": {
      "type": "string"
    },
    "agent_response": {
      "type": "string"
    },
    "response_time_ms": {
      "type": "integer",
      "description": "Total processing time in milliseconds."
    },
    "audit_flags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "security_blocked, permission_denied, high_risk, legal_question, etc."
    }
  },
  "additionalProperties": false
}