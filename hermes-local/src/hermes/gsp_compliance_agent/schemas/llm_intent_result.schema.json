{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gsp-compliance/schemas/llm_intent_result",
  "title": "LLM Intent Result",
  "description": "Structured output from the LLM intent classifier. The LLM decides which agent should handle the user's request.",
  "type": "object",
  "required": [
    "intent_id",
    "selected_agent",
    "confidence"
  ],
  "properties": {
    "intent_id": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "prefilter_id": {
      "type": "string",
      "description": "FK to intent_prefilter.prefilter_id."
    },
    "selected_agent": {
      "type": "string",
      "description": "agent_id the LLM chose."
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "intent_summary": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    },
    "normalized_user_request": {
      "type": "string"
    },
    "requires_permission": {
      "type": "boolean",
      "default": false
    },
    "required_permission": {
      "type": "string"
    },
    "risk_flags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "needs_clarification": {
      "type": "boolean",
      "default": false
    },
    "clarification_question": {
      "type": "string"
    },
    "handoff_message": {
      "type": "string"
    },
    "llm_model": {
      "type": "string"
    },
    "llm_mode": {
      "type": "string",
      "enum": [
        "mock",
        "real"
      ]
    },
    "tokens_used": {
      "type": "integer"
    },
    "latency_ms": {
      "type": "integer"
    }
  },
  "additionalProperties": false
}