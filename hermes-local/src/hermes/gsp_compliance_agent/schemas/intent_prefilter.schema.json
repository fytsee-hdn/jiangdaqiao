{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gsp-compliance/schemas/intent_prefilter",
  "title": "Intent Prefilter",
  "description": "Code-level preliminary filtering before LLM intent classification. Uses deterministic rules (not LLM) to narrow scope.",
  "type": "object",
  "required": [
    "prefilter_id",
    "user_message",
    "matched"
  ],
  "properties": {
    "prefilter_id": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "user_message": {
      "type": "string"
    },
    "message_type": {
      "type": "string",
      "enum": [
        "text",
        "image",
        "file",
        "voice"
      ]
    },
    "window_id": {
      "type": "string"
    },
    "matched": {
      "type": "boolean",
      "description": "True if prefilter found a deterministic match."
    },
    "matched_rules": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Which deterministic rules triggered."
    },
    "suggested_window": {
      "type": "string"
    },
    "suggested_agent": {
      "type": "string"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "blocked": {
      "type": "boolean",
      "description": "True if prefilter blocks this message (safety, rate limit)."
    },
    "block_reason": {
      "type": "string"
    },
    "context_snapshot": {
      "type": "object",
      "description": "Active conversation state at time of prefilter.",
      "properties": {
        "active_conversation": {
          "type": "boolean"
        },
        "active_agent": {
          "type": "string"
        },
        "conversation_id": {
          "type": "string"
        }
      }
    }
  },
  "additionalProperties": false
}