{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gsp-compliance/schemas/source_reconciliation",
  "title": "Source Reconciliation Record",
  "description": "Comparison result between PDF-extracted candidate and curated baseline (P8B). LLM recommendations only — not confirmation.",
  "type": "object",
  "required": ["reconciliation_id", "comparison_status", "recommended_action", "created_at"],
  "properties": {
    "reconciliation_id": {"type": "string"},
    "source_id": {"type": "string", "description": "FK to source_register.id."},
    "pdf_candidate_id": {"type": "string", "description": "FK to customer_requirement_master.id (PDF extraction)."},
    "curated_baseline_id": {"type": "string", "description": "FK to curated_baseline.curated_baseline_id."},
    "comparison_status": {"type": "string", "enum": [
      "exact_match", "text_similar_id_match", "id_mismatch",
      "missing_in_pdf_extraction", "extra_in_pdf_extraction",
      "level_mismatch", "section_mismatch", "text_incomplete",
      "duplicate_candidate", "needs_human_review"
    ]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "llm_recommendation": {"type": "string"},
    "llm_reasoning_summary": {"type": "string"},
    "code_match_signals": {"type": "object"},
    "normalized_pdf_code": {"type": "string"},
    "normalized_baseline_code": {"type": "string"},
    "text_similarity_score": {"type": "number"},
    "level_match": {"type": "boolean"},
    "section_match": {"type": "boolean"},
    "recommended_action": {"type": "string", "enum": [
      "confirm_requirement", "correct_pdf_candidate", "use_curated_baseline",
      "reject_pdf_candidate", "split_required", "merge_required",
      "level_review_required", "needs_human_review"
    ]},
    "human_decision_status": {"type": "string", "enum": [
      "pending_review", "accepted", "rejected", "corrected"
    ], "default": "pending_review"},
    "human_decision_id": {"type": "string"},
    "batch_id": {"type": "string"},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false
}
